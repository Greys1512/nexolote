
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node", "jest"],
    "noEmit": true,
    "declaration": false
  },
  "include": [
    "src/**/*.spec.ts",
    "test/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
